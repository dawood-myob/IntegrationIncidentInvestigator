<Window x:Class="IntegrationIncidentInvestigator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Integration Incident Investigator" Height="900" Width="1280" MinHeight="720" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Integration Incident Investigator" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Incident folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Browse..." Click="Browse_Click" Padding="14,6" Margin="0,0,8,0" />
            <Button Grid.Column="3" Content="Scan folder" Command="{Binding ScanCommand}" Padding="14,6" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8" IsEnabled="{Binding IsIdle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="System:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding SystemName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
            <TextBlock Grid.Column="2" Text="Integration:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="3" Text="{Binding IntegrationName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="5" Text="AI provider:" VerticalAlignment="Center" Margin="12,0,8,0" />
            <ComboBox Grid.Column="6" ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding SelectedProvider}" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="330" IsEditable="True" ItemsSource="{Binding ModelOptions}"
                          Text="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Choose a suggested model or enter an exact model ID supported by your provider/account." />
                <TextBlock Text="Choose or type an available model ID. Higher-capability models may cost more." VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="7" Text="{Binding ProviderHelp}" TextWrapping="Wrap" Foreground="#FF555555" Margin="0,2,0,0" />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,0,0,8" LastChildFill="False">
            <ItemsControl ItemsSource="{Binding ProviderStatuses}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0" ToolTip="{Binding Details}">
                            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF808080" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                <Setter Property="Fill" Value="#FF20A447" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Fill" Value="#FFD93025" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Status}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Refresh status" Command="{Binding RefreshProviderStatusCommand}" Padding="10,4" Margin="14,0,0,0" />
            <TextBlock Text="{Binding ProviderStatusMessage}" Foreground="#FF666666" VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Prepare evidence" Command="{Binding InvestigateCommand}" Padding="14,7" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Padding="14,7" Margin="0,0,12,0" />
            <TextBlock Grid.Column="2" Text="{Binding ProgressStage}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ProgressBar Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="18" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <Button Grid.Column="5" Content="Send reviewed evidence to AI" Command="{Binding SendEvidenceCommand}" Padding="14,7" />
        </Grid>

        <Border Grid.Row="5" Background="#FFF8E1" Padding="8" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#8A1C1C" />
        </Border>

        <TabControl Grid.Row="6">
            <TabItem Header="Incident files">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                              SelectionMode="Single" SelectionChanged="FilesGrid_SelectionChanged" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use for AI" Binding="{Binding IncludeInInvestigation, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                            <DataGridTextColumn Header="File" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Classification" Binding="{Binding Category}" IsReadOnly="True" Width="1.2*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding LastModified, StringFormat={}{0:g}}" IsReadOnly="True" Width="130" />
                            <DataGridTextColumn Header="Relevance" Binding="{Binding Relevance}" IsReadOnly="True" Width="85" />
                            <DataGridCheckBoxColumn Header="Attach to Jira" Binding="{Binding IncludeAsAttachment, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                            <DataGridTextColumn Header="Reason" Binding="{Binding AttachmentReason}" IsReadOnly="True" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="Problem description (loaded from problem.txt when present; edit before preparing evidence):" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ProblemDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0" />
                        <Border Grid.Column="1" BorderBrush="#FFBDBDBD" BorderThickness="1" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Screenshot preview (local only)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Image x:Name="ScreenshotImage" MaxHeight="260" Stretch="Uniform" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Prepared evidence" IsEnabled="{Binding HasPreparedEvidence}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Review the exact bounded text below. Nothing is sent until you click ‘Send reviewed evidence to AI’. Screenshot pixels are not uploaded." TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding PreparedIncidentMetadata}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding SelectedProvider, StringFormat=Provider: {0}}" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding SelectedModel, StringFormat=Model: {0}}" />
                        </StackPanel>
                        <Expander Header="Historical match information sent" IsExpanded="False" Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding PreparedHistoricalMatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Incident.IncidentId}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Incident.Title}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Incident.ErrorSignature}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Incident.RootCause}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Reasons}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                    <Expander Grid.Row="1" Header="Problem description sent" IsExpanded="False" Margin="0,0,0,8">
                        <TextBox Text="{Binding PreparedProblemDescription, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding PreparedEvidence}" SelectedItem="{Binding SelectedEvidence}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="1*" />
                            <DataGridTextColumn Header="Original size" Binding="{Binding OriginalSizeBytes}" Width="110" />
                            <DataGridTextColumn Header="Selected chars" Binding="{Binding SelectedCharacters}" Width="110" />
                            <DataGridTextColumn Header="Selection reason" Binding="{Binding SelectionReason}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Row="3" Text="{Binding SelectedEvidenceContent, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
            <TabItem Header="Investigation results" IsEnabled="{Binding HasResult}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="INCIDENT INVESTIGATION" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding RecurrenceLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,6" />
                        <TextBlock Text="{Binding Result.IncidentSummary}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Root cause confidence: " />
                            <TextBlock Text="{Binding ConfidenceLabel}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Teams summary" FontWeight="Bold" />
                        <TextBox Text="{Binding TeamsSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" Margin="0,4,0,4" />
                        <Button Content="Copy Teams Summary" Click="CopyTeams_Click" HorizontalAlignment="Left" Padding="14,6" Margin="0,0,0,12" />
                        <TextBlock Text="Root cause" FontWeight="Bold" />
                        <TextBlock Text="{Binding RootCause}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="Historical matches" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding HistoricalMatches}" Margin="0,4,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Incident.IncidentId}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Incident.JiraKey}" />
                                        <TextBlock Text="{Binding Similarity, StringFormat={}{0:P0}}" />
                                        <ItemsControl ItemsSource="{Binding Reasons}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Evidence supporting the assessment" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding EvidenceItems}" Margin="0,4,0,12" />
                        <TextBlock Text="Recommended next actions" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding RecommendedActions}" Margin="0,4,0,12" />
                        <TextBlock Text="Jira action" FontWeight="Bold" />
                        <ComboBox ItemsSource="{Binding JiraModes}" SelectedItem="{Binding SelectedJiraMode}" Width="240" HorizontalAlignment="Left" Margin="0,4" />
                        <TextBox Text="{Binding ExistingIssueReference, UpdateSourceTrigger=PropertyChanged}" ToolTip="Suggested or overridden Jira issue key" Width="240" HorizontalAlignment="Left" Margin="0,4,0,8" />
                        <TextBlock Text="Generated Jira content" FontWeight="Bold" />
                        <TextBox Text="{Binding SelectedJiraText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                            <Button Content="Copy Jira Content" Click="CopyJira_Click" Padding="14,6" Margin="0,0,8,0" />
                            <Button Content="Save investigation outputs" Command="{Binding SaveOutputsCommand}" Padding="14,6" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
